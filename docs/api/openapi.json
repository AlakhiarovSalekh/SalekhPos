{
  "openapi": "3.1.0",
  "info": {
    "title": "SalekhPos foundation API",
    "version": "1.2.0",
    "description": "Implemented branch access, token revocation and protected platform authority. Not a complete POS or identity provider."
  },
  "security": [
    {
      "bearer": []
    }
  ],
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "liveness",
        "security": [],
        "responses": {
          "200": {
            "description": "Process alive."
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "readiness",
        "security": [],
        "responses": {
          "200": {
            "description": "Configured authentication and safe database for authorized branch reads only."
          },
          "503": {
            "description": "Safe error response with code and traceId.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/organizations/{organizationId}/branches": {
      "get": {
        "operationId": "listBranches",
        "description": "Requires active membership and persisted branches.view grant. Organization/business/region/branch scopes are enforced by the server.",
        "parameters": [
          {
            "name": "organizationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "after",
            "in": "query",
            "description": "Prior nextCursor. Every page rechecks current authorization.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Bounded authorized page.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BranchPage"
                }
              }
            }
          },
          "400": {
            "description": "Safe error response with code and traceId.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Safe error response with code and traceId.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Safe error response with code and traceId.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Safe error response with code and traceId.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Safe error response with code and traceId.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Safe error response with code and traceId.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/organizations/{organizationId}/branches/{branchId}": {
      "get": {
        "operationId": "getBranch",
        "description": "Unauthorized branch and nonexistent branch both return 404 after membership authorization.",
        "parameters": [
          {
            "name": "organizationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "branchId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized active configured branch.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Branch"
                }
              }
            }
          },
          "400": {
            "description": "Safe error response with code and traceId.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Safe error response with code and traceId.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Safe error response with code and traceId.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Safe error response with code and traceId.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Safe error response with code and traceId.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Safe error response with code and traceId.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Safe error response with code and traceId.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/identity/revoke-current-token": {
      "post": {
        "operationId": "revokeCurrentToken",
        "description": "Durably revoke only the validated current API token. Provider sessions and refresh tokens are unaffected. Revoked credentials receive 401 on subsequent requests, including retries.",
        "responses": {
          "503": {
            "description": "Revocation could not be safely persisted."
          },
          "204": {
            "description": "Revocation and immutable audit committed."
          },
          "401": {
            "description": "Missing, invalid or already revoked bearer token."
          },
          "429": {
            "description": "Request capacity exceeded."
          }
        }
      }
    },
    "/api/v1/platform/authority": {
      "get": {
        "operationId": "getPlatformAuthority",
        "responses": {
          "401": {
            "description": "Invalid bearer credential."
          },
          "503": {
            "description": "Platform storage unavailable."
          },
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlatformAuthority"
                }
              }
            },
            "description": "Current persisted platform authority only."
          }
        }
      }
    },
    "/api/v1/platform/super-admins": {
      "post": {
        "responses": {
          "429": {
            "description": "Capacity exceeded."
          },
          "403": {
            "description": "Root authority or recent MFA missing."
          },
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuperAdmin"
                }
              }
            },
            "description": "Audited operation committed or safely replayed."
          },
          "409": {
            "description": "Operation conflicts with input or current state."
          },
          "400": {
            "description": "Invalid operation fields."
          },
          "503": {
            "description": "Platform storage unavailable."
          },
          "401": {
            "description": "Invalid bearer credential."
          }
        },
        "description": "Requires persisted original root authority and fresh configured MFA assurance. Exact operation retries return the original response snapshot.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "reason": {
                    "maxLength": 1000,
                    "type": "string",
                    "minLength": 1
                  },
                  "subject": {
                    "maxLength": 256,
                    "type": "string",
                    "minLength": 1
                  },
                  "operationId": {
                    "type": "string",
                    "format": "uuid"
                  }
                },
                "required": [
                  "operationId",
                  "reason",
                  "subject"
                ],
                "type": "object"
              }
            }
          }
        },
        "operationId": "registerSuperAdmin"
      }
    },
    "/api/v1/platform/super-admins/{adminId}/revoke": {
      "post": {
        "responses": {
          "429": {
            "description": "Capacity exceeded."
          },
          "403": {
            "description": "Root authority or recent MFA missing."
          },
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuperAdmin"
                }
              }
            },
            "description": "Audited operation committed or safely replayed."
          },
          "409": {
            "description": "Operation conflicts with input or current state."
          },
          "400": {
            "description": "Invalid operation fields."
          },
          "503": {
            "description": "Platform storage unavailable."
          },
          "401": {
            "description": "Invalid bearer credential."
          }
        },
        "description": "Requires persisted original root authority and fresh configured MFA assurance. Exact operation retries return the original response snapshot.",
        "parameters": [
          {
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "name": "adminId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "reason": {
                    "maxLength": 1000,
                    "type": "string",
                    "minLength": 1
                  },
                  "operationId": {
                    "type": "string",
                    "format": "uuid"
                  }
                },
                "required": [
                  "operationId",
                  "reason"
                ],
                "type": "object"
              }
            }
          }
        },
        "operationId": "revokeSuperAdmin"
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT (at+jwt; RS256, PS256 or ES256)"
      }
    },
    "schemas": {
      "Branch": {
        "type": "object",
        "required": [
          "id",
          "businessId",
          "regionId",
          "code",
          "name",
          "timeZoneId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "businessId": {
            "type": "string",
            "format": "uuid"
          },
          "regionId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "maxLength": 32
          },
          "name": {
            "type": "string",
            "maxLength": 200
          },
          "timeZoneId": {
            "type": "string",
            "description": "Explicit IANA time zone."
          }
        }
      },
      "BranchPage": {
        "type": "object",
        "required": [
          "items",
          "nextCursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/Branch"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        }
      },
      "Problem": {
        "type": "object",
        "required": [
          "status",
          "title",
          "code",
          "traceId"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "traceId": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "PlatformAuthority": {
        "properties": {
          "isRoot": {
            "type": "boolean"
          },
          "isSuperAdmin": {
            "type": "boolean"
          }
        },
        "required": [
          "isRoot",
          "isSuperAdmin"
        ],
        "type": "object"
      },
      "SuperAdmin": {
        "properties": {
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "isRoot": {
            "type": "boolean"
          },
          "issuer": {
            "type": "string"
          },
          "revokedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "subject": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "issuer",
          "subject",
          "isRoot",
          "isActive",
          "createdAt",
          "revokedAt"
        ],
        "type": "object"
      }
    }
  }
}
