{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "CountryDefinition",
  "required": [
    "code",
    "name",
    "currency",
    "timeZones"
  ],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "name": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "timeZones": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  }
}