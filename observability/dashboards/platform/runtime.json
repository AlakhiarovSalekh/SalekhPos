{
  "uid": "sp-runtime",
  "title": "SalekhPos Runtime",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "salekhpos"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Process CPU",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(process_cpu_seconds_total[5m]))"
        }
      ]
    },
    {
      "id": 2,
      "title": "Working set",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(process_resident_memory_bytes)"
        }
      ]
    }
  ]
}