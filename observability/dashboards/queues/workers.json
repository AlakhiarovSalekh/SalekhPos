{
  "uid": "sp-workers",
  "title": "SalekhPos Workers",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "salekhpos"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Queue depth",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(salekhpos_worker_queue_depth)"
        }
      ]
    },
    {
      "id": 2,
      "title": "Failures",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(salekhpos_worker_jobs_total{outcome=\"failed\"}[5m]))"
        }
      ]
    }
  ]
}