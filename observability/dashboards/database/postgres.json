{
  "uid": "sp-db",
  "title": "SalekhPos PostgreSQL",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "salekhpos"
  ],
  "panels": [
    {
      "id": 1,
      "title": "DB p95",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le)(rate(salekhpos_db_operation_duration_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "id": 2,
      "title": "DB errors",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(salekhpos_db_errors_total[5m]))"
        }
      ]
    }
  ]
}