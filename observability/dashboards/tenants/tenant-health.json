{
  "uid": "sp-tenants",
  "title": "Tenant Aggregate Health",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "salekhpos"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Active tenant requests",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total[5m]))"
        }
      ]
    },
    {
      "id": 2,
      "title": "Permission denials",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(salekhpos_authorization_denied_total[5m]))"
        }
      ]
    }
  ]
}