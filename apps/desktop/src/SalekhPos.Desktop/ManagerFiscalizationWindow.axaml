<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SalekhPos.Desktop.ManagerFiscalizationWindow" Title="SalekhPos Fiscalization" Width="860" Height="680"><ScrollViewer><StackPanel Margin="20" Spacing="12"><TextBlock Text="Fiscalization" FontSize="24" FontWeight="SemiBold"/><TextBlock Name="ScopeText" Foreground="#607080"/><TextBox Name="DocumentBox" PlaceholderText="Document UUID"/><Button Content="Generate document ID" Click="GenerateClick"/><TextBox Name="SaleBox" PlaceholderText="Sale UUID"/><TextBox Name="ProviderBox" Text="ge.default" PlaceholderText="Provider key"/><TextBox Name="TypeBox" Text="receipt" PlaceholderText="Document type"/><TextBox Name="CurrencyBox" Text="GEL" PlaceholderText="Currency"/><TextBox Name="AmountBox" Text="0" PlaceholderText="Gross amount"/><TextBox Name="PayloadBox" Text="{}" AcceptsReturn="True" Height="120" PlaceholderText="Fiscal payload"/><StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Submit" Click="SubmitClick"/><Button Content="Read" Click="ReadClick"/><Button Content="Retry" Click="RetryClick"/></StackPanel><TextBlock Name="StateText" TextWrapping="Wrap"/><ListBox Name="AttemptList" Height="180"/><TextBlock Name="MessageText" Foreground="#9C2B2B" TextWrapping="Wrap"/></StackPanel></ScrollViewer></Window>