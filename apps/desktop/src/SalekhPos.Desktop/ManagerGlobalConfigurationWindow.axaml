<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SalekhPos.Desktop.ManagerGlobalConfigurationWindow"
        Title="SalekhPos Global Configuration" Width="1040" Height="760" MinWidth="820" MinHeight="600">
  <TabControl Margin="18">
    <TabItem Header="Notifications">
      <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12" Margin="8">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
          <StackPanel><TextBlock Text="Notification center" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Review your inbox and delivery preferences." Foreground="{DynamicResource AppMutedTextBrush}"/></StackPanel>
          <Button Grid.Column="1" Content="Refresh" Click="RefreshNotificationsClick"/>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
          <CheckBox Name="UnreadOnlyBox" Content="Unread only" Click="RefreshNotificationsClick"/>
          <CheckBox Name="InAppBox" Content="In-app"/>
          <CheckBox Name="EmailBox" Content="Email"/>
          <CheckBox Name="PushBox" Content="Push"/>
          <Button Content="Save preferences" Click="SavePreferencesClick"/>
        </StackPanel>
        <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="8">
          <TextBlock Name="NotificationStatusText" Foreground="{DynamicResource AppMutedTextBrush}" TextWrapping="Wrap"/>
          <ListBox Grid.Row="1" Name="NotificationsList">
            <ListBox.ItemTemplate><DataTemplate x:CompileBindings="False">
              <Border BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,0,0,1" Padding="4,10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel><TextBlock Text="{Binding Heading}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Body}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Meta}" Foreground="{DynamicResource AppMutedTextBrush}"/></StackPanel>
                  <Button Grid.Column="1" Content="Mark read" Tag="{Binding Id}" Click="MarkReadClick"/>
                </Grid>
              </Border>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Grid>
    </TabItem>
    <TabItem Header="Taxation">
      <ScrollViewer><StackPanel Spacing="14" Margin="8">
        <TextBlock Text="Tax configuration" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock Text="Manage tax profiles, effective rates, and calculation previews." Foreground="{DynamicResource AppMutedTextBrush}"/>
        <Grid ColumnDefinitions="*,*,*,Auto" ColumnSpacing="10">
          <TextBox Name="ProfileCodeBox" PlaceholderText="Profile code" MaxLength="40"/>
          <TextBox Grid.Column="1" Name="ProfileNameBox" PlaceholderText="Profile name" MaxLength="120"/>
          <TextBox Grid.Column="2" Name="CountryCodeBox" PlaceholderText="Country code" MaxLength="2"/>
          <Button Grid.Column="3" Content="Create profile" Click="CreateProfileClick"/>
        </Grid>
        <CheckBox Name="PricesIncludeTaxBox" Content="Prices include tax"/>
        <ComboBox Name="ProfilesBox" SelectionChanged="ProfileSelectionChanged"/>
        <Grid ColumnDefinitions="*,*,*,Auto" ColumnSpacing="10">
          <TextBox Name="CategoryCodeBox" PlaceholderText="Category code" MaxLength="40"/>
          <TextBox Grid.Column="1" Name="RatePercentBox" PlaceholderText="Rate %"/>
          <CheckBox Grid.Column="2" Name="BranchSpecificBox" Content="Current branch only" VerticalAlignment="Center"/>
          <Button Grid.Column="3" Content="Add rate" Click="CreateRateClick"/>
        </Grid>
        <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="10">
          <TextBox Name="AmountBox" PlaceholderText="Amount" Text="100"/>
          <TextBox Grid.Column="1" Name="CalculateCategoryBox" PlaceholderText="Category code"/>
          <Button Grid.Column="2" Content="Calculate tax" Click="CalculateTaxClick"/>
        </Grid>
        <TextBlock Name="TaxStatusText" Foreground="{DynamicResource AppMutedTextBrush}" TextWrapping="Wrap"/>
        <ListBox Name="RatesList" Height="260"/>
      </StackPanel></ScrollViewer>
    </TabItem>
    <TabItem Header="Localization">
      <ScrollViewer><StackPanel Spacing="14" Margin="8">
        <TextBlock Text="Organization localization" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock Text="Configure country, locale, currency, timezone and supported locales." Foreground="{DynamicResource AppMutedTextBrush}"/>
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
          <TextBox Name="LocCountryBox" PlaceholderText="Country code" MaxLength="2"/>
          <TextBox Grid.Column="1" Name="LocCurrencyBox" PlaceholderText="Currency" MaxLength="3"/>
          <TextBox Grid.Column="2" Name="LocDefaultLocaleBox" PlaceholderText="Default locale" MaxLength="35"/>
        </Grid>
        <TextBox Name="LocTimeZoneBox" PlaceholderText="Timezone, e.g. Asia/Tbilisi" MaxLength="100"/>
        <TextBox Name="LocSupportedBox" PlaceholderText="Supported locales, comma-separated"/>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
          <TextBox Name="LocFirstDayBox" Text="1" PlaceholderText="First day of week (1-7)"/>
          <Button Grid.Column="1" Content="Save localization" Click="SaveLocalizationClick"/>
        </Grid>
        <TextBlock Name="LocalizationStatusText" Foreground="{DynamicResource AppMutedTextBrush}" TextWrapping="Wrap"/>
      </StackPanel></ScrollViewer>
    </TabItem>
  </TabControl>
</Window>
