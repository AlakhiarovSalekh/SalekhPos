<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SalekhPos.Desktop.ManagerIntegrationsWindow" Title="SalekhPos Integrations" Width="960" Height="700"><Grid Margin="20" RowDefinitions="Auto,*" RowSpacing="12"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="Integrations" FontSize="24" FontWeight="SemiBold"/><TextBlock Name="ScopeText" Foreground="#607080"/></StackPanel><Button Grid.Column="1" Content="Refresh" Click="RefreshClick"/></Grid><Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="14"><StackPanel Spacing="10"><TextBox Name="ProviderBox" Text="generic.http" PlaceholderText="Provider"/><TextBox Name="NameBox" Text="ERP" PlaceholderText="Display name"/><TextBox Name="EndpointBox" Text="https://example.invalid/webhook" PlaceholderText="Endpoint"/><TextBox Name="SecretBox" Text="secret://integration/default" PlaceholderText="Secret reference"/><Button Content="Create connection" Click="CreateClick"/><TextBlock Text="Connections" FontSize="18" FontWeight="SemiBold"/><ListBox Name="ConnectionList" Height="350"/></StackPanel><StackPanel Grid.Column="1" Spacing="10"><TextBlock Text="Webhook delivery health" FontSize="18" FontWeight="SemiBold"/><ListBox Name="WebhookList" Height="520"/><TextBlock Name="MessageText" Foreground="#9C2B2B" TextWrapping="Wrap"/></StackPanel></Grid></Grid></Window>