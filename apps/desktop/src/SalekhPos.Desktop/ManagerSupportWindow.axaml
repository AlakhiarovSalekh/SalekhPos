<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SalekhPos.Desktop.ManagerSupportWindow" Title="SalekhPos Support"
        Width="1120" Height="800" MinWidth="900" MinHeight="640">
  <Grid RowDefinitions="Auto,*" Margin="18" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
      <StackPanel><TextBlock Text="Support operations" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock Name="ScopeText" Foreground="{DynamicResource AppMutedTextBrush}"/></StackPanel>
      <ComboBox Grid.Column="1" Name="StatusFilter" SelectedIndex="0" Width="190">
        <ComboBoxItem Content="All tickets" Tag=""/>
        <ComboBoxItem Content="Open" Tag="open"/>
        <ComboBoxItem Content="In progress" Tag="in_progress"/>
        <ComboBoxItem Content="Waiting for customer" Tag="waiting_for_customer"/>
        <ComboBoxItem Content="Resolved" Tag="resolved"/>
        <ComboBoxItem Content="Closed" Tag="closed"/>
      </ComboBox>
      <Button Grid.Column="2" Content="Refresh" Click="RefreshClick"/>
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="14">
      <ScrollViewer><StackPanel Spacing="10">
        <TextBlock Text="Create branch ticket" FontSize="18" FontWeight="SemiBold"/>
        <TextBox Name="SubjectBox" PlaceholderText="Subject" MaxLength="200"/>
        <TextBox Name="DescriptionBox" PlaceholderText="Description" AcceptsReturn="True" TextWrapping="Wrap" Height="100" MaxLength="8000"/>
        <ComboBox Name="PriorityBox" SelectedIndex="1">
          <ComboBoxItem Content="low"/><ComboBoxItem Content="normal"/><ComboBoxItem Content="high"/><ComboBoxItem Content="urgent"/>
        </ComboBox>
        <Button Content="Create ticket" Click="CreateClick"/>
        <TextBlock Name="MessageText" Foreground="{DynamicResource AppMutedTextBrush}" TextWrapping="Wrap"/>
        <TextBlock Text="Tickets" FontSize="18" FontWeight="SemiBold"/>
        <ListBox Name="TicketList" Height="390" SelectionChanged="TicketSelectionChanged"/>
        <Button Name="LoadMoreButton" Content="Load more" Click="LoadMoreClick" IsVisible="False"/>
      </StackPanel></ScrollViewer>
      <ScrollViewer Grid.Column="1"><StackPanel Spacing="10">
        <TextBlock Text="Ticket detail" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Name="DetailTitle" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
        <TextBlock Name="DetailMeta" Foreground="{DynamicResource AppMutedTextBrush}" TextWrapping="Wrap"/>
        <TextBlock Name="DetailDescription" TextWrapping="Wrap"/>
        <TextBlock Text="Transition" FontSize="16" FontWeight="SemiBold"/>
        <ComboBox Name="TransitionStatusBox"/>
        <TextBox Name="TransitionNoteBox" PlaceholderText="Transition note" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="2000"/>
        <Button Name="TransitionButton" Content="Apply transition" Click="TransitionClick" IsEnabled="False"/>
        <TextBlock Text="Diagnostics" FontSize="16" FontWeight="SemiBold"/>
        <ListBox Name="DiagnosticList" Height="160"/>
        <TextBox Name="DiagnosticKindBox" Text="log" PlaceholderText="Kind" MaxLength="64"/>
        <TextBox Name="DiagnosticReferenceBox" PlaceholderText="Reference" MaxLength="512"/>
        <TextBox Name="DiagnosticShaBox" PlaceholderText="SHA-256" MaxLength="64"/>
        <Button Name="DiagnosticButton" Content="Attach diagnostic reference" Click="DiagnosticClick" IsEnabled="False"/>
      </StackPanel></ScrollViewer>
    </Grid>
  </Grid>
</Window>
