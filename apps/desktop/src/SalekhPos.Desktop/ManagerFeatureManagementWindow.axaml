<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SalekhPos.Desktop.ManagerFeatureManagementWindow" Title="SalekhPos Feature Management" Width="760" Height="520"><StackPanel Margin="20" Spacing="12"><TextBlock Text="Feature management" FontSize="24" FontWeight="SemiBold"/><TextBlock Name="ScopeText" Foreground="#607080"/><TextBox Name="KeyBox" Text="pos.core" PlaceholderText="Feature key"/><TextBox Name="ReasonBox" Text="Operational override" PlaceholderText="Override reason"/><StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Evaluate" Click="EvaluateClick"/><Button Content="Enable" Click="EnableClick"/><Button Content="Disable" Click="DisableClick"/></StackPanel><Border Background="White" Padding="14"><TextBlock Name="DecisionText" TextWrapping="Wrap"/></Border><TextBlock Name="MessageText" Foreground="#9C2B2B" TextWrapping="Wrap"/></StackPanel></Window>