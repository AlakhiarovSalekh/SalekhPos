<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SalekhPos.Desktop.ManagerSubscriptionsWindow" Title="SalekhPos Subscriptions" Width="880" Height="680"><Grid Margin="20" RowDefinitions="Auto,*" RowSpacing="12"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="Subscriptions" FontSize="24" FontWeight="SemiBold"/><TextBlock Name="ScopeText" Foreground="#607080"/></StackPanel><Button Grid.Column="1" Content="Refresh plans" Click="RefreshClick"/></Grid><Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="14"><StackPanel Spacing="10"><TextBlock Text="Plans" FontSize="18" FontWeight="SemiBold"/><ListBox Name="PlanList" Height="480"/></StackPanel><StackPanel Grid.Column="1" Spacing="10"><TextBlock Text="Subscription lookup" FontSize="18" FontWeight="SemiBold"/><TextBox Name="SubscriptionBox" PlaceholderText="Subscription UUID"/><Button Content="Load" Click="LoadClick"/><TextBlock Name="SubscriptionText" TextWrapping="Wrap"/><TextBlock Text="Entitlements" FontSize="18" FontWeight="SemiBold"/><ListBox Name="EntitlementList" Height="280"/><TextBlock Name="MessageText" Foreground="#9C2B2B" TextWrapping="Wrap"/></StackPanel></Grid></Grid></Window>