<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SalekhPos.Desktop.ViewModels"
        x:Class="SalekhPos.Desktop.MainWindow"
        x:DataType="vm:CashierViewModel"
        Title="SalekhPos" Width="1180" Height="760" MinWidth="900" MinHeight="600">
  <Grid RowDefinitions="Auto,*" Background="{DynamicResource AppBackgroundBrush}">
    <Border Background="{DynamicResource AppHeaderBrush}" Padding="20,14">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="18">
        <StackPanel>
          <TextBlock Text="SalekhPos" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource AppHeaderTextBrush}" />
          <TextBlock Text="{Binding SessionStatus}" Foreground="{DynamicResource AppHeaderMutedBrush}" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding SyncStatus}" VerticalAlignment="Center" Foreground="{DynamicResource AppHeaderTextBrush}" />
        <Button Grid.Column="2" Content="Synchronize" Click="SynchronizeClick" IsEnabled="{Binding IsReady}" />
        <Button Grid.Column="3" Content="Management" Click="ManagementClick" />
        <Button Grid.Column="4" Content="Global config" Click="GlobalConfigurationClick" />
        <Button Grid.Column="5" Content="Analytics" Click="AnalyticsClick" />
        <Button Grid.Column="6" Content="Accounting" Click="AccountingClick" />
        <Button Grid.Column="7" Content="Support" Click="SupportClick" />
        <Button Grid.Column="8" Content="Platform" Click="PlatformClick" />
        <Button Grid.Column="9" Content="Audit" Click="AuditClick" />
        <Button Grid.Column="10" Content="Purchasing" Click="PurchasingClick" />
        <Button Grid.Column="11" Content="Notifications" Click="NotificationsClick" />
        <Button Grid.Column="12" Content="Sign out" Click="SignOutClick" />
      </Grid>
    </Border>
    <Grid Grid.Row="1" ColumnDefinitions="2*,*" Margin="20" ColumnSpacing="20">
      <Border Background="{DynamicResource AppSurfaceBrush}" CornerRadius="8" Padding="20">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBox Name="BarcodeBox" PlaceholderText="Scan barcode" KeyDown="BarcodeKeyDown" />
            <Button Grid.Column="1" Content="Add" Click="AddBarcodeClick" />
          </Grid>
          <ListBox Grid.Row="1" ItemsSource="{Binding CartLines}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:CartLineViewModel">
                <Grid ColumnDefinitions="*,Auto,Auto" Margin="4,8" ColumnSpacing="18">
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Sku}" Foreground="{DynamicResource AppMutedTextBrush}" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding QuantityText}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding TotalText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Grid.Row="2" Text="{Binding CartStatus}" Foreground="{DynamicResource AppMutedTextBrush}" />
        </Grid>
      </Border>
      <Border Grid.Column="1" Background="{DynamicResource AppSurfaceBrush}" CornerRadius="8" Padding="20">
        <StackPanel Spacing="14">
          <TextBlock Text="Cash checkout" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="{Binding GrandTotalText}" FontSize="36" FontWeight="Bold" />
          <TextBox Name="CashReceivedBox" PlaceholderText="Cash received" />
          <Button Content="Complete sale" Click="CompleteSaleClick" IsEnabled="{Binding CanCompleteSale}" />
          <Separator Margin="0,8" />
          <TextBlock Text="Open shift" FontSize="18" FontWeight="SemiBold" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
            <TextBox Name="OpenCurrencyBox" Text="GEL" PlaceholderText="Currency" />
            <TextBox Grid.Column="1" Name="OpeningBalanceBox" Text="0" PlaceholderText="Opening balance" />
          </Grid>
          <Button Content="Open shift" Click="OpenShiftClick" IsEnabled="{Binding CanOpenShift}" />
          <Separator Margin="0,8" />
          <TextBlock Text="Cash management" FontSize="18" FontWeight="SemiBold" />
          <ComboBox Name="MovementKindBox" SelectedIndex="0">
            <ComboBoxItem Content="cash_in" />
            <ComboBoxItem Content="cash_out" />
          </ComboBox>
          <TextBox Name="MovementAmountBox" PlaceholderText="Amount" />
          <TextBox Name="MovementReasonBox" PlaceholderText="Reason" />
          <Button Content="Record movement" Click="RecordMovementClick" IsEnabled="{Binding IsOnlineSession}" />
          <TextBox Name="CountedCashBox" PlaceholderText="Counted cash" />
          <Button Content="Close shift" Click="CloseShiftClick" IsEnabled="{Binding IsOnlineSession}" />
          <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource AppDangerTextBrush}" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
