<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SalekhPos.Desktop.ManagerPlatformWindow" Title="SalekhPos Platform Operations" Width="720" Height="520"><StackPanel Margin="24" Spacing="14"><TextBlock Text="Platform operations" FontSize="28" FontWeight="SemiBold"/><TextBlock Name="ScopeText" Foreground="#607080"/><TextBlock Text="Open a production control surface. Server permissions remain authoritative." TextWrapping="Wrap"/><Button Content="Feature management" Click="FeaturesClick"/><Button Content="Fiscalization" Click="FiscalizationClick"/><Button Content="Integrations" Click="IntegrationsClick"/><Button Content="Billing" Click="BillingClick"/><Button Content="Subscriptions" Click="SubscriptionsClick"/></StackPanel></Window>