<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SalekhPos.Desktop.ManagerBillingWindow" Title="SalekhPos Billing" Width="820" Height="620"><StackPanel Margin="20" Spacing="12"><TextBlock Text="Billing" FontSize="24" FontWeight="SemiBold"/><TextBlock Name="ScopeText" Foreground="{DynamicResource AppMutedTextBrush}"/><TextBlock Text="Create billing account" FontSize="18" FontWeight="SemiBold"/><TextBox Name="LegalNameBox" Text="Example Store LLC" PlaceholderText="Legal name"/><TextBox Name="EmailBox" Text="billing@example.test" PlaceholderText="Billing email"/><TextBox Name="CurrencyBox" Text="GEL" PlaceholderText="Currency"/><Button Content="Create account" Click="CreateAccountClick"/><TextBlock Name="AccountText" TextWrapping="Wrap"/><Separator/><TextBlock Text="Invoice lookup" FontSize="18" FontWeight="SemiBold"/><TextBox Name="InvoiceBox" PlaceholderText="Invoice UUID"/><Button Content="Load invoice" Click="LoadInvoiceClick"/><Border Background="{DynamicResource AppSurfaceBrush}" Padding="14"><TextBlock Name="InvoiceText" TextWrapping="Wrap"/></Border><TextBlock Name="MessageText" Foreground="{DynamicResource AppDangerTextBrush}" TextWrapping="Wrap"/></StackPanel></Window>