{
  "name": "@salekhpos/apps-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "SalekhPos mobile application for iOS and Android",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
